// A build without a Developer ID, for GitHub releases until one is available. Pass it as
// XCODE_XCCONFIG_FILE: macOS runs a Network Extension only with a Developer ID, so the VPN runs in
// hiddify-core's tunnel service, `Road --tunnel run` as root (macos/TunnelService), and the app is
// signed ad hoc.
ROAD_NETWORK_EXTENSION_ENABLED = NO
ROAD_EXTENSION_CODE_SIGN_ALLOWED = NO
ROAD_HOST_ENTITLEMENTS = Runner/Developer.entitlements
ROAD_CODE_SIGN_STYLE = Manual
ROAD_CODE_SIGN_IDENTITY = -
ROAD_HOST_PROVISIONING_PROFILE =
ROAD_TUNNEL_PROVISIONING_PROFILE =
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = NO
