// A build without a Developer ID, for GitHub releases until one is available. Pass it as
// XCODE_XCCONFIG_FILE: macOS runs a Network Extension only with a Developer ID, so the VPN runs in
// hiddify-core's tunnel service, `Tropa --tunnel run` as root (macos/TunnelService), and the app is
// signed ad hoc.
TROPA_NETWORK_EXTENSION_ENABLED = NO
TROPA_EXTENSION_CODE_SIGN_ALLOWED = NO
TROPA_HOST_ENTITLEMENTS = Runner/Developer.entitlements
TROPA_CODE_SIGN_STYLE = Manual
TROPA_CODE_SIGN_IDENTITY = -
TROPA_HOST_PROVISIONING_PROFILE =
TROPA_TUNNEL_PROVISIONING_PROFILE =
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = NO
